<Page x:Class="Abazov_323.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Цикл и График">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Image Source="/task3.png" Height="100" Margin="10" Stretch="Uniform"/>
            <Image x:Name="imgFormula" Height="70" Margin="5" ToolTip="Вариант 14"/>
            <TextBlock Text="Начало (x0):" Margin="5,2,5,0"/>
            <TextBox x:Name="txtX0" Text="0,25" Margin="5" ToolTip="Начальное значение"/>
            <TextBlock Text="Конец (xk):" Margin="5,0"/>
            <TextBox x:Name="txtXk" Text="5,2" Margin="5" ToolTip="Конечное значение"/>
            <TextBlock Text="Шаг (dx):" Margin="5,0"/>
            <TextBox x:Name="txtDx" Text="0,3" Margin="5" ToolTip="Приращение"/>
            <TextBlock Text="Параметр b:" Margin="5,0"/>
            <TextBox x:Name="txtB" Text="0,8" Margin="5" ToolTip="Константа b"/>

            <UniformGrid Columns="2">
                <Button Content="Вычислить" Click="btnCalculate_Click" Margin="5" Height="30"/>
                <Button Content="Очистить" Click="btnClear_Click" Margin="5" Height="30"/>
            </UniformGrid>

            <TextBlock Text="Результаты:" Margin="5,5,5,0"/>
            <TextBox x:Name="txtResult" Height="150" Margin="5" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" IsReadOnly="True" Background="#F9F9F9"/>
        </StackPanel>

        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="10" Background="White">
            <Canvas x:Name="chartCanvas" ClipToBounds="True">
                <Polyline x:Name="graphPolyline" Stroke="Blue" StrokeThickness="2"/>
            </Canvas>
        </Border>
    </Grid>
</Page>