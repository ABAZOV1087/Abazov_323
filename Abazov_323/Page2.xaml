<Page x:Class="Abazov_323.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Разветвляющийся алгоритм">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Left" Width="400">
            <Image Source="/task2.png" Height="100" Margin="10" Stretch="Uniform"/>

            <TextBlock Text="Введите x:" Margin="0,5,0,0"/>
            <TextBox x:Name="txtX" Margin="0,0,0,10" ToolTip="Переменная x"/>

            <TextBlock Text="Введите y:" Margin="0,5,0,0"/>
            <TextBox x:Name="txtY" Margin="0,0,0,10" ToolTip="Переменная y"/>

            <TextBlock Text="Выберите f(x):" FontWeight="Bold" Margin="0,10,0,5"/>
            <RadioButton x:Name="rbSinh" Content="sh(x)" IsChecked="True" ToolTip="Гиперболический синус"/>
            <RadioButton x:Name="rbSqr" Content="x^2" ToolTip="Квадрат x"/>
            <RadioButton x:Name="rbExp" Content="e^x" ToolTip="Экспонента"/>

            <UniformGrid Columns="2" Margin="0,20,0,0">
                <Button Content="Вычислить" Click="btnCalculate_Click" Height="30" Margin="5" ToolTip="Выполнить расчет по условию"/>
                <Button Content="Очистить" Click="btnClear_Click" Height="30" Margin="5" ToolTip="Сбросить все поля"/>
            </UniformGrid>

            <TextBlock Text="Результат (d):" Margin="0,20,0,0"/>
            <TextBox x:Name="txtResult" IsReadOnly="True" Background="#F0F0F0" Margin="0,5,0,0" ToolTip="Результат вычислений"/>
        </StackPanel>
    </Grid>
</Page>